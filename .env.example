# Copy to .env and fill in values after deploying contracts

# Deployer/relayer private key (no 0x prefix)
RELAYER_PRIVATE_KEY=your_private_key_here

# Contract addresses (filled in after `yarn deploy --network monad_testnet`)
LAND_REGISTRY_ADDRESS=0x...
CURRENCY_FACTORY_ADDRESS=0x...
GAME_CORE_ADDRESS=0x...

# Optional: override RPC
BLOCKCHAIN_RPC_URL=https://testnet-rpc.monad.xyz
